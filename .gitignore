# ==============================================================================
# ARIA .gitignore — Sensitive files and build artifacts
# ==============================================================================

# ─── SECRETS (NEVER COMMIT) ───────────────────────────────────────────────────
.env
*.key
*.pem
secrets/

# ─── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# pytest / testing
.pytest_cache/
.cache/
htmlcov/
.tox/
.nox/
coverage.xml
*.cover
*.py,cover
.hypothesis/
nosetests.xml

# mypy / type checkers
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/

# ─── Node / Frontend ─────────────────────────────────────────────────────────
node_modules/
ARIAFrontend/node_modules/
ARIAFrontend/dist/
ARIAFrontend/.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.tsbuildinfo

# ─── Data / Logs / Temp ───────────────────────────────────────────────────────
*.log
logs/
data/
temp_audio/
*.wav
*.mp3
*.webm
*.jpg
*.jpeg
*.png
*.gif
*.bmp

# ─── OS / IDE ─────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*.swo
*~

# ─── Whisper / ML Model Caches ───────────────────────────────────────────────
*.pt
*.bin
*.safetensors
~/.cache/whisper/

# ─── Windows ─────────────────────────────────────────────────────────────────
$RECYCLE.BIN/
*.lnk
