# ==============================================================================
# ARIA Global Environment Configuration Template
# Copy this file to .env and adjust values as needed.
# ==============================================================================

HOST=0.0.0.0
DEFAULT_TIMEOUT=30.0
HEALTH_TIMEOUT=2.0

SPEECH_PORT=8000
BRAIN_PORT=8001
BROWSER_PORT=8002
DESKTOP_PORT=8003
FILE_PORT=8004
GATEWAY_PORT=8080

SPEECH_API_URL=http://127.0.0.1:8000
BRAIN_API_URL=http://127.0.0.1:8001
BROWSER_API_URL=http://127.0.0.1:8002
DESKTOP_API_URL=http://127.0.0.1:8003
FILE_API_URL=http://127.0.0.1:8004
GATEWAY_API_URL=http://127.0.0.1:8080

OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=phi3:mini
USE_LLM=false

# OpenAI API Key (used as primary intelligence engine)
# Get yours at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here

# GitHub Token for Automatic Project Board & Issue Management
# Generate with 'repo' and 'project' scopes at: https://github.com/settings/tokens
GITHUB_TOKEN=ghp_your_github_personal_access_token

HEADLESS=false
PAGE_LOAD_TIMEOUT=45000

PYAUTOGUI_FAILSAFE=false
PYAUTOGUI_PAUSE=0.05

WHISPER_MODEL=base
SPEECH_LANGUAGE=en
